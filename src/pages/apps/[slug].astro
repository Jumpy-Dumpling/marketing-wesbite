---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import { apps } from '../../data/apps';
import ShareLinks from '../../components/ShareLinks.astro';
import { url } from '../../lib/url';
import { absolute, SITE_NAME } from '../../lib/seo';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;

const pageUrl = absolute(`apps/${app.slug}/`, Astro.site);
const homeUrl = absolute('', Astro.site);
const orgId = `${homeUrl}#organization`;
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    '@id': `${pageUrl}#app`,
    name: app.name,
    description: app.intro,
    url: pageUrl,
    image: absolute(`og/${app.slug}.png`, Astro.site),
    applicationCategory: app.category,
    operatingSystem: 'iOS',
    keywords: app.keywords.join(', '),
    featureList: app.features.map((f) => f.title),
    author: { '@id': orgId },
    publisher: { '@id': orgId },
    ...(app.stores.find((s) => s.href) && { installUrl: app.stores.find((s) => s.href)!.href }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: app.name, item: pageUrl },
    ],
  },
  { '@type': 'Organization', '@id': orgId, name: SITE_NAME, url: homeUrl },
];
---
<Base
  title={`${app.name}: ${app.descriptor}`}
  description={`${app.intro} A ${SITE_NAME} app.`}
  image={`og/${app.slug}.png`}
  imageAlt={`${app.name}, a ${SITE_NAME} app`}
  jsonLd={jsonLd}
  compactFooter
>
  <div class="app" style={`--app-accent:${app.accent};--app-tint:${app.accentTint}`}>
    <section class="container head">
      <p class="back"><a href={url('#apps')}>&larr; All apps</a></p>
      <div class="title">
        <Image class="icon" src={app.icon} alt={`${app.name} app icon`} width={128} height={128} loading="eager" />
        <div>
          <Badge tone="yellow">{app.status}</Badge>
          <h1>{app.name}</h1>
          <p class="intro">{app.intro}</p>
          <div class="stores">
            {app.stores.map((s) =>
              s.href
                ? <Button href={s.href} variant="primary" external>{s.label}</Button>
                : <span class="soon">{s.label}: coming soon</span>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="container features">
      <h2>What it does</h2>
      <ul>
        {app.features.map((f) => (
          <li><h3>{f.title}</h3><p>{f.body}</p></li>
        ))}
      </ul>
    </section>

    <section class="container share-section">
      <ShareLinks href={pageUrl} text={`${app.name}, a ${SITE_NAME} app: ${app.blurb}`} />
    </section>
  </div>
</Base>

<style>
  .head { padding-block: 1rem 3rem; }
  .back a { font-weight: 700; }
  .title { display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;
    background: var(--app-tint); border: 2px solid var(--jd-dark); border-radius: 28px; padding: clamp(1.5rem, 5vw, 3rem); }
  .icon { border-radius: 28px; border: 2px solid var(--jd-dark); box-shadow: var(--shadow-soft); flex: none; }
  h1 { margin: 0.6rem 0 0.4rem; }
  .intro { max-width: 36rem; font-size: 1.15rem; }
  .stores { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .soon { font-weight: 700; color: var(--jd-muted); }
  .features ul { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .features li { background: var(--jd-card); border: 2px solid var(--jd-dark); border-radius: var(--radius-card); padding: 1.4rem; box-shadow: var(--shadow-soft); }
  .features li::before { content: ''; display: block; width: 2.2rem; height: 0.4rem; border-radius: 4px; background: var(--app-accent); margin-bottom: 0.9rem; }
  .features p { margin: 0; color: var(--jd-muted); }
  .share-section { padding-top: 3rem; }
</style>
